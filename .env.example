# ─── CEAK Digital — variáveis de ambiente ───────────────────────────
# Copie para .env. Sem credenciais externas, tudo roda com adapters mock.

# Banco (Postgres local ou `supabase start`, que expõe a porta 54322)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Sessão: segredo com 32+ caracteres (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-este-segredo-de-desenvolvimento-com-32+-caracteres"
# local | supabase
AUTH_PROVIDER="local"
# Supabase Auth (quando AUTH_PROVIDER=supabase)
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""

# URLs públicas dos apps (links entre site, app e gestão)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_GESTAO_URL="http://localhost:3002"

# Adapters (por enquanto apenas "mock"; os reais entram nas fases 4 e 5)
PAYMENT_PROVIDER="mock"
PIX_WEBHOOK_SECRET="dev-webhook-secret"
AI_PROVIDER="mock"
# mock | webpush (webpush exige as chaves VAPID abaixo)
PUSH_PROVIDER="mock"
EMAIL_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"
SOCIAL_PROVIDER="mock"

# CEAK App
# Validade da sessão do App, em dias (padrão 30; a do Gestão expira em 30 min de inatividade)
APP_SESSAO_DIAS="30"
# Segredo do QR Code de check-in (16+ caracteres). Sem ele, usa o AUTH_SECRET.
CHECKIN_SECRET=""
# Web Push: gere com `npx web-push generate-vapid-keys`. Sem as chaves, o push fica desligado (mock).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@allankardecpenapolis.com.br"
# Opcional: grava as mensagens dos mocks (e-mail, WhatsApp, push) neste arquivo (JSON Lines)
MOCK_CAIXA_ARQUIVO=""

# Senha dos usuários do seed (apenas desenvolvimento)
SEED_SENHA="ceak-dev-2026"
# Segredo do autenticador (base32) do seed para Administrador, Diretoria e Tesouraria
SEED_TOTP_SEGREDO="JBSWY3DPEHPK3PXPCEAKDEVSEEDTOTPA"
